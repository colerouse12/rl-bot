{
  "schema_version": 1,
  "run_name": "1v1-cpu",
  "device": "cpu",
  "random_seed": 123,
  "torch_threads": 2,
  "num_games": 8,
  "tick_skip": 8,
  "action_delay": 7,
  "mesh_dir": "collision_meshes",
  "checkpoint_dir": "checkpoints/1v1-cpu",
  "max_iterations": 0,
  "timesteps_per_save": 100000,
  "checkpoints_to_keep": 8,
  "environment": { "no_touch_seconds": 10.0, "episode_seconds": 120.0 },
  "network": {
    "shared_layers": [128, 128],
    "policy_layers": [128, 128],
    "critic_layers": [128, 128],
    "layer_norm": true
  },
  "ppo": {
    "timesteps_per_iteration": 8192,
    "batch_size": 8192,
    "minibatch_size": 1024,
    "epochs": 2,
    "policy_learning_rate": 0.00015,
    "critic_learning_rate": 0.00015,
    "entropy_scale": 0.035,
    "gae_gamma": 0.99,
    "gae_lambda": 0.95
  }
}
